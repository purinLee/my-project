# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. NEVER commit the real file.
#
# Everything below is OPTIONAL. Without a key the app uses its deterministic
# rule-based classifier and assistant, so no secret is required to run the demo.

# OPENAI_API_KEY = "sk-..."

# Model to call (default: gpt-4.1-mini). Use any chat-completions model your key can access.
# OPENAI_MODEL = "gpt-4.1-mini"

# Any OpenAI-compatible endpoint (default: https://api.openai.com/v1).
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# Hard cap on LLM calls per server process per UTC day; beyond it the app silently uses the rules engine (default 200).
# OPENAI_MAX_CALLS_PER_DAY = "200"

# Cost estimates use a built-in price table for gpt-4o-mini, gpt-4o and gpt-4.1-mini. For any other model, or if prices
# change, set USD per 1M tokens here; otherwise the cost of calls to unknown models is logged as NULL (never guessed).
# OPENAI_PRICE_INPUT_PER_1M = "0.40"
# OPENAI_PRICE_OUTPUT_PER_1M = "1.60"
