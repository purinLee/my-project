# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. NEVER commit the real file.
#
# Everything below is OPTIONAL. Without a key the app uses its deterministic
# rule-based classifier and assistant, so no secret is required to run the demo.

# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = "https://api.openai.com/v1"
